# Example .env file (DO NOT COMMIT)
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/velvi_naturals?retryWrites=true&w=majority

# JWT secret for auth
JWT_SECRET=yourStrongJwtSecret

# Server configuration
PORT=5000
CLIENT_URL=http://localhost:5173

# Razorpay credentials (for future integration)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Cloudinary credentials (for future integration)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
